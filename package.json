{
  "name": "nerva-root",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "start": "npm run start-win",
    "start-win": "concurrently \"npm run start-frontend\" \"npm run start-backend-win\"",
    "start-mac": "concurrently \"npm run start-frontend\" \"npm run start-backend-mac\"",
    "start-frontend": "cd frontend && npm run dev -- --host 0.0.0.0",
    "start-backend-win": "cd backend && .venv\\Scripts\\activate && uvicorn app.main:app --reload --host 0.0.0.0",
    "start-backend-mac": "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --host 0.0.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
